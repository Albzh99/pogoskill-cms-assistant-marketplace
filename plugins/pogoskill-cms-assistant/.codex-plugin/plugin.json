{
  "name": "pogoskill-cms-assistant",
  "version": "1.0.0+codex.20261009034725",
  "description": "\u516c\u53f8\u591a\u7ad9\u70b9 CMS \u6587\u7ae0\u89c4\u8303\u5efa\u7acb\u4e0e\u8349\u7a3f\u52a9\u624b\uff0c\u4fdd\u7559 PoGoskill \u7e41\u4e2d\u53ca\u82f1\u6587\u7ad9\u4e13\u7528\u6d41\u7a0b",
  "author": {
    "name": "PoGoskill Team"
  },
  "skills": "./skills/",
  "interface": {
    "displayName": "CMS \u6587\u7ae0\u52a9\u624b\uff08\u542b PoGoskill\uff09",
    "shortDescription": "\u4e3a\u65b0\u7f51\u7ad9\u5efa\u7acb\u72ec\u7acb\u6587\u7ae0\u89c4\u8303\uff0c\u5e76\u6309\u89c4\u8303\u5904\u7406 CMS \u8349\u7a3f\u3002",
    "longDescription": "\u4e3a\u516c\u53f8 CMS \u4e2d\u4e0d\u540c\u7f51\u7ad9\u4e0e\u6587\u7ae0\u7c7b\u578b\u5efa\u7acb\u6709\u771f\u5b9e\u53c2\u8003\u9875\u8bc1\u636e\u7684\u72ec\u7acb\u89c4\u8303\u548c\u6821\u9a8c\u5668\uff0c\u6309\u89c4\u8303\u5236\u4f5c\u548c\u56de\u8bfb\u6587\u7ae0\u8349\u7a3f\u3002\u4fdd\u7559 PoGoskill \u7e41\u4e2d\u3001\u82f1\u6587\u7ad9\u539f\u6709\u4e13\u7528\u6d41\u7a0b\uff1b\u7ad9\u70b9\u6a21\u677f\u3001\u4ea7\u54c1\u3001\u7ec4\u4ef6\u4e0e\u56fe\u7247\u57df\u540d\u9694\u79bb\u3002",
    "developerName": "PoGoskill Team",
    "category": "Productivity",
    "capabilities": [
      "Read",
      "Write"
    ],
    "defaultPrompt": [
      "\u4f7f\u7528\u5b8c\u6574\u6587\u7ae0\u52a9\u624b\u628a\u8fd9\u7bc7 DOCX \u8f6c\u6210 PoGoskill V2 HTML\uff0c\u4e0a\u4f20\u5e76\u5355\u72ec\u53d1\u5e03\u6240\u6709\u65b0\u56fe\u7247\u8d44\u6e90\uff0c\u7136\u540e\u4fdd\u5b58\u3001\u56de\u8bfb\u548c\u673a\u68b0\u5ba1\u67e5 CMS \u8349\u7a3f\u3002\u5fc5\u987b\u5bf9\u8d26\u6e90 DOCX \u56fe\u7247\u51fa\u73b0\u6b21\u6570\u3001manifest \u548c\u56de\u8bfb HTML\uff0c\u5c11\u4e00\u5f20\u5373\u7981\u6b62\u5199\u5165\u6216\u58f0\u79f0\u5b8c\u6210\uff1b\u4e0d\u6267\u884c AI \u9875\u9762\u9884\u89c8\uff0c\u4e0d\u751f\u6210\u6216\u53d1\u5e03\u6587\u7ae0\u9875\u9762\u3002",
      "\u5904\u7406\u8fd9\u7bc7\u6587\u7ae0\u7684\u56fe\u7247\uff1a\u4fdd\u7559\u539f\u56fe\u3001\u751f\u6210 WebP\u3001\u6210\u5bf9\u4e0a\u4f20\u3001\u4f7f\u7528\u56fe\u7247\u4e0a\u4f20 publish_id \u5355\u72ec\u53d1\u5e03\u56fe\u7247\u8d44\u6e90\uff0c\u518d\u56de\u586b\u8349\u7a3f\u3002",
      "\u72ec\u7acb\u5ba1\u67e5\u8fd9\u4e2a CMS \u8349\u7a3f\u7684\u5b57\u6bb5\u3001HTML\u3001\u6765\u6e90\u8986\u76d6\u548c\u56fe\u7247\uff0c\u4e0d\u6267\u884c AI \u9875\u9762\u9884\u89c8\u3002",
      "\u4f7f\u7528\u82f1\u6587\u6587\u7ae0\u52a9\u624b\u5904\u7406\u8fd9\u7bc7\u82f1\u6587 DOCX\u3002\u8bf7\u7528\u4e2d\u6587\u6c47\u62a5\uff0c\u6587\u7ae0\u6b63\u6587\u4fdd\u6301\u82f1\u6587\uff1b\u53d1\u5e03\u65b0\u4e0a\u4f20\u7684\u56fe\u7247\u8d44\u6e90\u5e76\u4fdd\u5b58\u3001\u56de\u8bfb CMS \u8349\u7a3f\uff0c\u4e0d\u751f\u6210\u6216\u53d1\u5e03\u6587\u7ae0\u9875\u9762\u3002",
      "\u4f7f\u7528 $cms-site-standard-builder \u4e3a\u53e6\u4e00\u4e2a\u516c\u53f8\u7f51\u7ad9\u5efa\u7acb\u65b0\u7684\u6587\u7ae0\u89c4\u8303\u3002\u5148\u8bfb\u8be5\u7ad9\u70b9\u771f\u5b9e CMS \u6587\u7ae0\u3001\u6a21\u677f\u5b57\u6bb5\u3001\u56fe\u7247\u548c\u7ec4\u4ef6\uff0c\u6309\u7f51\u7ad9\u4e0e\u6587\u7ae0\u7c7b\u578b\u5206\u522b\u4fdd\u5b58 profile\u3001HTML \u5951\u7ea6\u548c\u6821\u9a8c\u5668\uff1b\u4e0d\u8981\u5957\u7528 PoGoskill \u7684\u6837\u5f0f\u6216 ID\u3002\u53ea\u5efa\u7acb\u89c4\u8303\uff0c\u4e0d\u4e0a\u4f20\u6587\u7ae0\u3002",
      "\u4f7f\u7528 $cms-site-article-assistant \u6309\u5df2\u9a8c\u8bc1\u7684\u7f51\u7ad9 profile \u5b8c\u6574\u5904\u7406\u8fd9\u7bc7\u6587\u7ae0\u3002\u8bf7\u4f7f\u7528\u8be5\u7ad9\u70b9\u7684\u6a21\u677f\u3001\u7ec4\u4ef6\u3001\u56fe\u7247\u548c CMS \u5b57\u6bb5\uff0c\u9010\u9879\u68c0\u67e5\u6e90\u6587\u4e0e\u56fe\u7247\uff0c\u4fdd\u5b58\u8349\u7a3f\u540e\u56de\u8bfb\u6838\u5bf9\uff1b\u4e0d\u8981\u751f\u6210\u6216\u53d1\u5e03\u6587\u7ae0\u3002"
    ]
  }
}
