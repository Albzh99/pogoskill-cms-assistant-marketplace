  "skills": "./skills/",
  "interface": {
    "displayName": "Tenorshare CMS \u6587\u7ae0\u52a9\u624b",
    "shortDescription": "\u4ece CMS \u65e7\u6587\u7ae0\u5b66\u4e60\u4efb\u4e00\u4ea7\u54c1\u8bed\u8a00\u7f51\u7ad9\u7684\u7248\u5f0f\uff0c\u5b8c\u6574\u4fdd\u5b58\u65b0\u6587\u7ae0\u8349\u7a3f\u3002",
    "longDescription": "\u8fd0\u8425\u53ea\u9700\u63d0\u4f9b\u4ea7\u54c1\u3001\u8bed\u8a00\u548c\u65b0\u7a3f\uff1b\u52a9\u624b\u4ece CMS \u8bfb\u53d6\u8be5\u7ad9\u540c\u7c7b\u6587\u7ae0\u5efa\u7acb\u72ec\u7acb\u89c4\u8303\uff0c\u5904\u7406\u56fe\u7247\u5e76\u7ecf\u5199\u540e\u56de\u8bfb\u9a8c\u8bc1\u8349\u7a3f\u3002PoGoskill \u4e13\u7528\u6280\u80fd\u4ecd\u4fdd\u7559\uff0c\u4f46\u4e0d\u4f1a\u5957\u7528\u5230\u5176\u4ed6\u7ad9\u70b9\u3002",
    "developerName": "Tenorshare Team",
    "category": "Productivity",
    "capabilities": [
      "Read",
      "Write"
    ],
    "defaultPrompt": [
      "\u6211\u8d1f\u8d23\u3010\u4ea7\u54c1\u540d\u3011\u3010\u8bed\u8a00\u3011\u7f51\u7ad9\u3002\u8fd9\u662f\u65b0\u6587\u7ae0\u3002\u8bf7\u4f7f\u7528 $tenorshare-cms-article-assistant\uff0c\u4ece CMS \u540c\u7ad9\u70b9\u540c\u7c7b\u65e7\u6587\u7ae0\u5b66\u4e60 HTML \u89c4\u8303\uff0c\u5b8c\u6574\u5904\u7406\u6587\u5b57\u548c\u56fe\u7247\uff0c\u901a\u8fc7 CMS API \u4fdd\u5b58\u5e76\u56de\u8bfb\u8349\u7a3f\u3002\u4e0d\u8981\u751f\u6210\u6216\u53d1\u5e03\u6587\u7ae0\u3002",
      "\u8bf7\u5b89\u88c5\u5e76\u68c0\u67e5 Tenorshare CMS \u6587\u7ae0\u52a9\u624b\u3002\u5148\u68c0\u67e5\u5df2\u4fdd\u5b58\u7684 CMS Key\uff1b\u6ca1\u6709\u65f6\u624d\u6253\u5f00\u53ef\u89c1\u7ec8\u7aef\uff0c\u8ba9\u6211\u590d\u5236 Key \u540e\u6309 Enter\u3002\u8bf7\u6309\u672c\u673a Windows \u6216 macOS \u6267\u884c\u5e76\u9a8c\u8bc1\u3002",
      "\u4f7f\u7528 $cms-site-standard-builder \u4e3a\u6211\u8d1f\u8d23\u7684\u7ad9\u70b9\u5efa\u7acb\u72ec\u7acb\u6587\u7ae0\u89c4\u8303\u3002\u4f18\u5148\u8bfb\u53d6 CMS \u540c\u7c7b\u65e7\u6587\u7ae0\uff1b\u6211\u4e0a\u4f20\u7684\u65e7 HTML \u4f5c\u4e3a\u8865\u5145\u3002\u8fd9\u4e00\u6b65\u4e0d\u8981\u4e0a\u4f20\u65b0\u6587\u7ae0\u3002",
      "\u4f7f\u7528 $pogoskill-cms-article-assistant \u5904\u7406\u8fd9\u7bc7 PoGoskill \u7e41\u4e2d DOCX\uff0c\u4e0a\u4f20\u65b0\u56fe\u7247\u8d44\u6e90\u5e76\u4fdd\u5b58\u3001\u56de\u8bfb\u8349\u7a3f\uff1b\u4e0d\u751f\u6210\u6216\u53d1\u5e03\u6587\u7ae0\u3002",
      "\u4f7f\u7528 $pogoskill-cms-en-publisher \u5904\u7406\u8fd9\u7bc7 PoGoskill \u82f1\u6587 DOCX\uff0c\u7528\u4e2d\u6587\u6c47\u62a5\u5e76\u4fdd\u5b58\u3001\u56de\u8bfb\u8349\u7a3f\uff1b\u4e0d\u751f\u6210\u6216\u53d1\u5e03\u6587\u7ae0\u3002"
    ]
  }
}
